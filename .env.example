# Copy to .env and fill in.

# Database connection string (Prisma datasource).
# - Local dev (SQLite):   file:./dev.db
# - Deploy (Neon/Postgres): postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="file:./dev.db"

# Secret for signing the JWT session token (HS256). Use a long random value.
# PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Linux/Mac:  openssl rand -base64 32
# GS_COOKIE_SECRET (legacy HMAC cookie) is still read as a fallback / for the
# one-time legacy-account migration; GS_AUTH_SECRET is the canonical one now.
GS_AUTH_SECRET="change-me-to-a-long-random-string"
GS_COOKIE_SECRET="change-me-to-a-long-random-string"

# Email (magic-link sign-in + "sua vez" notifications).
# Leave RESEND_API_KEY empty in dev: the magic link is logged to the server
# console and echoed back to the sign-in form. Set it in prod to send real mail.
RESEND_API_KEY=""
EMAIL_FROM="attacca <onboarding@resend.dev>"

# Public base URL — used to build absolute magic-link / email URLs behind a
# proxy. Optional in dev (derived from the request / defaults to localhost:4000).
APP_URL="https://your-app.onrender.com"

# Google sign-in (OAuth 2.0 / OIDC). Optional: leave empty and the modal simply
# hides the Google button, falling back to the e-mail magic link.
# Create at https://console.cloud.google.com/apis/credentials → "OAuth client ID"
# → Web application. Authorized redirect URI must be exactly:
#   http://localhost:4000/api/auth/google/callback   (dev)
#   https://your-app.onrender.com/api/auth/google/callback   (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
