# Copy to .env and fill in. These are the only env vars the app needs.

# Database connection string (Prisma datasource).
# - Local dev (SQLite):   file:./dev.db
# - Deploy (Postgres):    postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL="file:./dev.db"

# Secret for signing the identity cookie (HMAC). Use a long random value on deploy
# (e.g. `openssl rand -base64 32`). If unset, a known insecure dev default is used.
GS_COOKIE_SECRET="change-me-to-a-long-random-string"
