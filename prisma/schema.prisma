// attacca — data model (Milestone 1 + M2 cell grid)
// See CLAUDE.md and docs/adr/0002-modelo-de-celulas.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A musical piece. Holds an ordered history of revisions.
model Song {
  id        String     @id @default(cuid())
  title     String
  artist    String?
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Maintainer model (ADR 0003 rev): the creator owns the song and is the accept
  // authority. ownerId null = legacy/open (anyone identified accepts).
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  revisions Revision[]
  // M2 live collaborative grid:
  /// Opaque global alphaTex header (\title/\artist/stylesheet) for assembly.
  headerFragment String?
  tracks         Track[]
  measures       Measure[]
  cells          Cell[]

  // Async loop: people who follow the song (the mural's demand side) + the
  // notifications tied to it.
  watches       SongWatch[]
  notifications Notification[]

  @@index([ownerId])
}

/// One uploaded (or seeded) version of a Song's score.
/// History is immutable: reverting creates a NEW revision (git-style).
model Revision {
  id     String @id @default(cuid())
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId String

  /// Sequential per-song number (1, 2, 3, …). The current revision is the max.
  number Int

  /// Stub author until real auth exists.
  authorName String  @default("anon")
  /// Optional note describing the upload ("started the guitar track").
  message    String?

  /// Where the score content comes from: "file" (uploaded) or "alphatex" (seed/demo).
  source String

  // --- File-backed revisions (source = "file") ---
  originalName String? // original filename as uploaded
  /// Provenance blob stored IN the DB (no disk) — deploy-friendly (ADR 0003).
  blob         Bytes?
  storedPath   String? // LEGACY: path under storage/ for pre-DB-blob rows
  sizeBytes    Int     @default(0)

  // --- Inline revisions (source = "alphatex") ---
  alphaTex String? // AlphaTex notation text (used by the seed demo)

  /// "gp" | "musicxml" | "alphatex"
  format String

  /// "import" (materialized upload) | "snapshot" (frozen from the cell grid).
  /// Revisions are immutable snapshots/provenance; live work happens on cells.
  kind String @default("import")

  createdAt DateTime @default(now())

  @@unique([songId, number])
}

// ---------------------------------------------------------------------------
// M2 — live collaborative grid (trilha × compasso). See ADR 0002.
// Truth lives in CellContribution; the full alphaTex is a derived artifact.
// ---------------------------------------------------------------------------

/// Stable per-song track (the "row" of the grid). Identity is the id, not order.
model Track {
  id     String @id @default(cuid())
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId String

  order          Int // position among tracks
  name           String
  headerFragment String? // opaque alphaTex \track/\staff/\tuning header (assembly)
  tuning         String? // tokens e.g. "E4 B3 G3 D3 A2 E2" (UI/reading)
  instrument     Int? // GM program (UI)
  isPercussion   Boolean @default(false)

  // Ownership: ownerId is the real gate (ADR 0003); ownerName is a denormalized
  // display cache. Unclaimed = ownerId null = the open invitation.
  ownerName String?
  ownerId   String?
  owner     User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  cells Cell[]

  @@unique([songId, order])
  @@index([songId])
  @@index([ownerId])
}

/// Stable per-song measure (the "column"). Holds the SHARED structural scaffold.
model Measure {
  id     String @id @default(cuid())
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId String

  order         Int // position among measures
  tsNumerator   Int     @default(4) // typed: UI reads to draw the grid
  tsDenominator Int     @default(4)
  tempo         Int? // typed: UI
  /// Opaque alphaTex masterbar metadata (section, \ro/\rc/\ae, \jump, \beaming…).
  /// Avoids enumerating every structural case as a typed column.
  structPrefix  String?

  cells Cell[]

  @@unique([songId, order])
  @@index([songId])
}

/// The slot at (track, measure). One per intersection.
model Cell {
  id     String @id @default(cuid())
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId String

  track     Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId   String
  measure   Measure @relation(fields: [measureId], references: [id], onDelete: Cascade)
  measureId String

  /// Pointer to the live "accepted" content. NoAction avoids a cascade cycle
  /// with CellContribution.cell (Cascade); repoint before deleting the accepted one.
  acceptedContributionId String?           @unique
  acceptedContribution   CellContribution? @relation("acceptedContribution", fields: [acceptedContributionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  contributions CellContribution[] @relation("cellContributions")

  @@unique([trackId, measureId])
  @@index([songId])
  @@index([trackId])
  @@index([measureId])
}

/// Versioned content of a cell + authorship + status. THE source of truth.
model CellContribution {
  id     String @id @default(cuid())
  cell   Cell   @relation("cellContributions", fields: [cellId], references: [id], onDelete: Cascade)
  cellId String

  // Authorship: authorId is the real identity (ADR 0003); authorName is a
  // denormalized display cache (also covers legacy/anon rows).
  authorName String  @default("anon")
  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// The cell's fragment: per-track bar metadata (clef/ks) + notes, as alphaTex.
  alphaTex   String
  status     String  @default("accepted") // "accepted" | "proposed" | "rejected"
  message    String?
  createdAt  DateTime @default(now())

  /// M3 — the merge base (git-style): what the cell had ACCEPTED when this
  /// contribution was written (null = cell was empty, or legacy pre-M3 row).
  /// Conflict = base ≠ current accepted AND normalized content differs; the
  /// owner then resolves bar by bar. Plain pointer, no FK (provenance only).
  baseContributionId String?

  /// Back-relation for the cell that has THIS contribution accepted.
  acceptedInCell Cell? @relation("acceptedContribution")

  @@index([cellId])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Identity — "real enough" (ADR 0003). Lightweight, cookie-backed; no auth.
// ---------------------------------------------------------------------------

/// A person. Identity is anchored to a verified EMAIL (durable, cross-device) —
/// authorship survives a cookie clear or a device switch. Auth is passwordless
/// (magic link) with a JWT session cookie; there is no password. `email` is
/// nullable only to carry legacy cookie-only users until they claim an email.
model User {
  id            String    @id @default(cuid())
  displayName   String
  email         String?   @unique
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  /// Instruments this person plays (INSTRUMENT_PRESETS keys). Declared in the
  /// settings page; the incompleteness wall uses it to surface the songs that
  /// need YOUR instrument — the pull that answers the density risk.
  instruments String[] @default([])

  ownedSongs    Song[]
  ownedTracks   Track[]
  contributions CellContribution[]
  watches       SongWatch[]
  notifications Notification[]
}

/// A single-use magic-link token (passwordless sign-in). We store only the
/// SHA-256 hash — the raw token lives solely in the emailed URL. Short-lived and
/// consumed on first use. `claimUserId` attaches the email to an EXISTING account
/// in place — used both by the legacy cookie bridge and by "trocar e-mail" in the
/// settings page — so authorship is never forked into a second identity.
model LoginToken {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  displayName String? // proposed name when creating a brand-new account
  claimUserId String? // existing user to attach this email to
  /// Where to land after consuming the link (e.g. /settings for an email change).
  redirectTo  String?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

// ---------------------------------------------------------------------------
// Async loop — closing the relay so it doesn't depend on luck (reload). No
// email/push yet (matches the cookie-identity model; email arrives with the
// magic-link upgrade). In-app notifications + a lightweight "follow".
// ---------------------------------------------------------------------------

/// A person follows a song — the mural's demand side ("falta baixo, me avisem
/// quando entregarem"). Auto-created on meaningful interaction (proposing,
/// contributing) and via an explicit "Seguir" button for pure lurkers.
model SongWatch {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId String

  createdAt DateTime @default(now())

  @@unique([userId, songId])
  @@index([songId])
}

/// One in-app notification for a user. Denormalizes songTitle/actorName so it
/// renders cheaply and survives even if the source is later reworked.
model Notification {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// "proposal_received" | "proposal_accepted" | "proposal_rejected"
  /// | "track_progress" | "slot_declared"
  type String

  song      Song    @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId    String
  songTitle String // denormalized display
  actorName String // who caused it (proposer / reviewer / declarer)
  trackName String? // affected track, when relevant
  count     Int? // e.g. bars in a proposal
  message   String // rendered pt-BR line

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
